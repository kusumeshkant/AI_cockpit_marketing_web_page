# Cloudflare Pages headers.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# Two placeholders below are substituted at build time by
# scripts/csp-headers.mjs:
#   __INLINE_SCRIPT_HASHES__  a sha256 per inline <script> Next emits into out/.
#                             A static export has no request-time nonce, so
#                             hashes are the only way to keep script-src strict
#                             while letting the RSC payload run.
#   __NOINDEX_HEADER__        an X-Robots-Tag line when NEXT_PUBLIC_NOINDEX is
#                             "true", otherwise removed entirely.

/*
  # Never let a browser second-guess a declared content type.
  X-Content-Type-Options: nosniff
  # Send the origin cross-site, the full path same-origin.
  Referrer-Policy: strict-origin-when-cross-origin
  # The site is never meant to be framed.
  X-Frame-Options: DENY
__NOINDEX_HEADER__
  # HTTPS only, once the domain is stable.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Opt out of the powerful features the page does not use.
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # Content Security Policy.
  #   script-src carries a hash per inline script; no 'unsafe-inline'.
  #   'wasm-unsafe-eval' covers three.js' optional wasm paths.
  #   challenges.cloudflare.com is Turnstile: its script, and the iframe it
  #   opens when a visitor has to be challenged.
  #   connect-src stays 'self' — /api/inquiry is same-origin, and Turnstile
  #   reports through its own frame.
  #   'unsafe-inline' on style-src is required: Next inlines the stylesheet
  #   (experimental.inlineCss) and React writes inline style attributes.
  #   frame-ancestors repeats X-Frame-Options for browsers that honour CSP only.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com __INLINE_SCRIPT_HASHES__; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests

# Build output is content-hashed, so it can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/posters/*
  Cache-Control: public, max-age=604800

# HTML must revalidate so a redeploy is picked up immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
