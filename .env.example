# ---------------------------------------------------------------------------
# Build-time, public. These are inlined into the bundle, so changing one needs
# a rebuild — not just a redeploy of out/. Nothing secret belongs here.
# ---------------------------------------------------------------------------

# Absolute site origin, used for the canonical URL and the Open Graph tags.
# There is no fallback: when unset the canonical, og:url and the social-card
# image are omitted rather than pointing at a guessed domain.
# Staging: https://aicockpit.dqstore.in
NEXT_PUBLIC_SITE_URL=

# "true" on staging so the temporary subdomain stays out of search results:
# emits <meta name="robots" content="noindex, nofollow">, an X-Robots-Tag
# header and a robots.txt containing "Disallow: /".
NEXT_PUBLIC_NOINDEX=

# Cloudflare Turnstile site key for the demo request form. Public by design.
# Leave it blank locally: the widget is skipped, and the endpoint only skips
# verification when its own secret is unset, so a deployed site cannot be
# bypassed by an unconfigured client.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Runtime secrets for functions/api/inquiry.ts. These are NOT set here — they
# live only as Cloudflare Pages secrets:
#
#   wrangler pages secret put TURNSTILE_SECRET_KEY --project-name ai-cockpit
#   wrangler pages secret put RESEND_API_KEY       --project-name ai-cockpit
#   wrangler pages secret put INQUIRY_TO_EMAIL     --project-name ai-cockpit
#   wrangler pages secret put INQUIRY_FROM_EMAIL   --project-name ai-cockpit
#   wrangler pages secret put IP_HASH_SALT         --project-name ai-cockpit  (optional)
#
# For local `wrangler pages dev`, put them in .dev.vars, which is gitignored.
# ---------------------------------------------------------------------------
