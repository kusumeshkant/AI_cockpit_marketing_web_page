# ---------------------------------------------------------------------------
# All three are inlined at BUILD time. Changing one requires a rebuild,
# not just a redeploy of out/.
# ---------------------------------------------------------------------------

# External booking link used by every "Book a demo" / "Get early access" CTA.
# Cal.com or Calendly URL. Falls back to "#book-demo" when unset, which keeps
# the page usable locally.
NEXT_PUBLIC_DEMO_URL=

# Absolute site origin, used for the canonical URL and the Open Graph tags.
# There is no fallback: when this is unset the canonical, og:url and the
# social-card image are omitted rather than pointing at a guessed domain.
# Staging: https://aicockpit.dqstore.in
NEXT_PUBLIC_SITE_URL=

# Set to "true" on staging so the temporary subdomain stays out of search
# results: emits <meta name="robots" content="noindex, nofollow"> and a
# robots.txt containing "Disallow: /". Leave blank/false for production.
NEXT_PUBLIC_NOINDEX=
